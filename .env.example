# Application
ENVIRONMENT=LOCAL
DEBUG=true
APP_VERSION=0.1.0
APP_NAME=MembrrHub
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/membrhub

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
INVITATION_TOKEN_EXPIRE_DAYS=7

# AWS General
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS SES
SES_FROM_EMAIL=noreply@membrhub.com
SES_FROM_NAME=MembrrHub

# AWS S3
S3_BUCKET_NAME=membrhub-files
S3_PRESIGNED_URL_EXPIRY=3600

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_HEADERS=["*"]
CORS_METHODS=["*"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Community Limits
MAX_ADMINS_PER_COMMUNITY=3
MAX_COMMITTEE_MEMBERS_PER_COMMUNITY=10
