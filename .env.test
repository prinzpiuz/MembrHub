# Application
ENVIRONMENT=LOCAL
DEBUG=true
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/membrhub

# Security
SECRET_KEY=your-super-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# AWS General
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS SES
SES_FROM_EMAIL=noreply@membrhub.com
SES_FROM_NAME=MembrrHub

# AWS S3
S3_BUCKET_NAME=membrhub-files
S3_PRESIGNED_URL_EXPIRY=3600

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
